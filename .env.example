# Optional: choose the LLM backend. Default is the local Ollama model.
# Set this to groq to use the Groq cloud model instead.
# LLM_BACKEND=ollama

# Copy this file to .env and paste your real Groq API key after the equals sign.
# No spaces around the = and no quotes around the key.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
